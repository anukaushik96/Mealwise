# Neon / Postgres. Use the POOLED endpoint (-pooler) — the app opens one connection per
# request, which suits pgbouncer.
DATABASE_URL=

# Claude — powers nutrition estimation and the recommendation engine.
ANTHROPIC_API_KEY=

# 32-byte base64 key encrypting Swiggy tokens at rest. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Rotating this makes every stored token undecryptable and forces all users to
# reconnect, so set it once.
TOKEN_ENCRYPTION_KEY=

# Signs the session cookie. Generate the same way.
SESSION_SECRET=

# Origin used to build the OAuth redirect_uri. No trailing slash.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL (the stable production
# host) if unset — never VERCEL_URL, which changes per deployment and so can never be a
# registered redirect_uri.
APP_URL=http://localhost:8000

# Loopback port for the CLI login callback only (not used by the web app).
SWIGGY_CALLBACK_PORT=8765
